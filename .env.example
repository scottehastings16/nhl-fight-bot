# Twitter API Credentials (Get from https://developer.twitter.com/en/portal/dashboard)
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Monitoring Settings (in milliseconds)
POLL_INTERVAL=30000  # 30 seconds

# Active Hours (24-hour format, leave empty to run 24/7)
ACTIVE_HOURS_START=16  # 4pm
ACTIVE_HOURS_END=6     # 6am
TIMEZONE=America/Chicago

# Daily Leaderboard (posts at same time every day)
DAILY_LEADERBOARD_ENABLED=true
DAILY_LEADERBOARD_TIME=12:00  # 24-hour format (HH:MM) - uses TIMEZONE setting
